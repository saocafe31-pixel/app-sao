# Supabase (จำเป็นสำหรับการรันแอป)
#
# หลังโคลน / คัดลอกโปรเจกต์:
#   1) คัดลอกไฟล์นี้เป็น .env.local (อย่าใช้ .env.local จากเครื่องอื่น — จะชี้ DB คนละโปรเจกต์)
#   2) ใส่ค่าจาก Supabase → Project Settings → API
#   3) ห้าม commit .env.local ลง Git
#
# คู่มือเต็ม: docs/CLONE_APP.md และ ENV_SETUP.md

VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=

# Optional: Sentry DSN สำหรับ error tracking (production)
# ใส่เมื่อติดตั้ง @sentry/react และต้องการส่ง error ไป Sentry
# VITE_SENTRY_DSN=
